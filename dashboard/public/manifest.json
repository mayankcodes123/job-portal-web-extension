{
  "manifest_version": 3,
  "name": "Job Application CRM",
  "version": "0.1.0",
  "description": "Track job applications with a Kanban dashboard.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://www.naukri.com/*"
  ],

  "background": {
    "service_worker": "serviceWorker.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.naukri.com/job-listings-*"
      ],
      "js": [
        "naukri.js"
      ]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  }
}